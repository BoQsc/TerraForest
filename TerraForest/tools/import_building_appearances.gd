extends SceneTree
# Only technical size/format normalization. Material artwork is generated by imagegen.
const SOURCE="res://reviews/building_expansion/materials_v2/"
const TARGET="res://addons/structures/textures/expansion_v2/"
func _initialize()->void:
	DirAccess.make_dir_recursive_absolute(TARGET)
	var prompts:Dictionary=JSON.parse_string(FileAccess.get_file_as_string(SOURCE+"prompts.json"))
	var receipt:={"license":"CC0-1.0","creator":"TerraForest contributors with OpenAI image generation","source":"Original separate built-in image_gen.imagegen outputs, 2026-10-30; no external image inputs","dedication":"New original asset contributions under the repository CC0-1.0 contribution policy, to the extent rights exist and are held by the contributors. No third-party rights are relicensed.","version":2,"status":"candidate; engineering and in-world visual review required","preparation":"Godot Image Lanczos resize to 512 square RGB8; no artistic pixel edits","prompts":"reviews/building_expansion/materials_v2/prompts.json","assets":[]}
	for spec:Dictionary in prompts.assets:
		var path:String=SOURCE+spec.name+".png"
		var original:=Image.load_from_file(path)
		if original==null:quit(1);return
		var entry:={"appearance":spec.appearance,"name":spec.name,"source_path":path,"source_sha256":FileAccess.get_sha256(path),"source_dimensions":[original.get_width(),original.get_height()],"prompt":spec.prompt}
		if spec.name=="weathered_timber":entry["selected_edit"]=JSON.parse_string(FileAccess.get_file_as_string(SOURCE+"timber_edit.json"))
		for size in [512,1024]:
			var target:String=TARGET if size==512 else SOURCE+"runtime_1024/"
			DirAccess.make_dir_recursive_absolute(target)
			var pixels:=original.duplicate() as Image;pixels.convert(Image.FORMAT_RGB8);pixels.resize(size,size,Image.INTERPOLATE_LANCZOS)
			var destination:String=target+spec.name+".trtex"
			if pixels.save_png(destination)!=OK:quit(1);return
			entry[str(size)]={"path":destination,"sha256":FileAccess.get_sha256(destination)}
		receipt.assets.append(entry)
	FileAccess.open(TARGET+"provenance.json",FileAccess.WRITE).store_string(JSON.stringify(receipt,"  ")+"\n")
	print("IMPORT_BUILDING_APPEARANCES count=8 sizes=512,1024 failures=0");quit()
