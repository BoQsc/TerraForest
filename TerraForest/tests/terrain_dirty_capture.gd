# SPDX-License-Identifier: 0BSD
extends SceneTree
const Codec=preload("res://addons/volumetric_terrain/mesh_codec.gd")
var failures:=0
var checks:=0
func check(ok:bool,label:String)->void:
 checks+=1
 if not ok:failures+=1
 print("PASS " if ok else "FAIL ",label)
func _initialize()->void:run.call_deferred()
func raw(core:RefCounted)->PackedByteArray:return core.execute(Codec.command(4,[3])).slice(12)
func edit(core:RefCounted,p:Vector3,depth:float=0.6)->void:
 p.y=core.execute(Codec.point_command(p)).decode_float(12)-depth
 check(Codec.reply_ok(core.execute(Codec.brush(p,p,2.5,0,false,1))),"excavation admitted")
func run()->void:
 var path:=ProjectSettings.globalize_path("user://terrain_dirty_%d_%d"%[OS.get_process_id(),Time.get_ticks_usec()])
 var core:RefCounted=ClassDB.instantiate("TerrainCore")
 core.execute(Codec.command(6,[1703,19]))
 for i in range(64):edit(core,Vector3(808+(i%8)*80,0,808+(i/8)*80))
 var store:RefCounted=ClassDB.instantiate("NativeTerrainRegionStore")
 check(store.open_store(path,true),"native store opens")
 var initial=core.capture_storage_snapshot();var initial_stats:Dictionary=initial.stats()
 check(initial_stats.sealed and initial_stats.dirty_pages==initial_stats.pages,"initial capture contains every page")
 check(not core.commit_storage_snapshot(initial,PackedByteArray()),"unpublished capture cannot become clean")
 var reference:PackedByteArray=store.publish_capture(initial)
 check(reference.size()==40 and store.expand_snapshot(reference)==raw(core),"initial capture reconstructs exact field")
 var other:RefCounted=ClassDB.instantiate("TerrainCore")
 check(not other.commit_storage_snapshot(initial,reference),"capture is bound to its terrain owner")
 check(core.commit_storage_snapshot(initial,reference),"published capture acknowledged")
 var unchanged=core.capture_storage_snapshot();var before:Dictionary=store.stats()
 check(unchanged.stats().dirty_pages==0 and unchanged.stats().sample_bytes==0,"unchanged capture copies no field samples")
 check(store.publish_capture(unchanged,reference)==reference,"unchanged checkpoint identity retained")
 check(store.stats().written_bytes==before.written_bytes,"unchanged checkpoint writes no bytes")
 check(core.commit_storage_snapshot(unchanged,reference),"unchanged capture acknowledged")
 edit(core,Vector3(808,0,808),2.0)
 var frozen=core.capture_storage_snapshot();var frozen_raw:=raw(core);var small:Dictionary=frozen.stats()
 check(small.dirty_pages>0 and small.dirty_pages<initial_stats.pages/8,"local capture contains only touched pages")
 check(store.publish_capture(frozen,PackedByteArray()).is_empty(),"incremental capture rejects wrong inherited root")
 # Simulate failure of the outer world publication: publishing immutable products
 # alone must never acknowledge the field, and a retry must still capture changes.
 check(store.publish_capture(frozen,reference,0).is_empty(),"interrupted checkpoint rejected")
 check(core.capture_storage_snapshot().stats().dirty_pages==small.dirty_pages,"failed publication preserves dirty pages")
 var next:PackedByteArray=store.publish_capture(frozen,reference)
 check(store.expand_snapshot(next)==frozen_raw,"incremental merge reconstructs exact frozen field")
 check(store.publish_snapshot(frozen_raw,reference)==next,"incremental publication matches full archive checkpoint")
 edit(core,Vector3(888,0,808),2.0)
 check(core.commit_storage_snapshot(frozen,next),"older durable capture acknowledged after a newer edit")
 var later=core.capture_storage_snapshot()
 check(later.stats().dirty_pages>0,"edits after capture remain dirty")
 check(store.expand_snapshot(next)==frozen_raw,"frozen capture remains immutable")
 var latest:PackedByteArray=store.publish_capture(later,next)
 var latest_raw:=raw(core)
 check(store.expand_snapshot(latest)==latest_raw and core.commit_storage_snapshot(later,latest),"next publication includes concurrent edits exactly")
 var data:=Codec.command(5);data.append_array(latest_raw)
 check(Codec.reply_ok(other.execute(data)),"fresh owner loads expanded field")
 check(not other.configure_storage_checkpoint(latest,latest_raw.decode_u32(latest_raw.size()-4)^1),"incorrect load checksum rejected")
 check(other.configure_storage_checkpoint(latest,latest_raw.decode_u32(latest_raw.size()-4)),"verified loaded checkpoint establishes clean baseline")
 check(other.capture_storage_snapshot().stats().sample_bytes==0,"fresh reopen captures no unchanged samples")
 var road:=Codec.graded_bed(Vector3(1100,100,1100),Vector3(1120,100,1100),3.0,2.0,0.0,1)
 check(Codec.reply_ok(core.execute(road)),"graded terrain field created")
 var road_capture=core.capture_storage_snapshot();var road_ref:PackedByteArray=store.publish_capture(road_capture,latest)
 check(core.commit_storage_snapshot(road_capture,road_ref),"graded terrain checkpoint acknowledged")
 road=Codec.graded_bed(Vector3(1100,100,1100),Vector3(1120,100,1100),3.0,2.0,0.0,3)
 check(Codec.reply_ok(core.execute(road)),"material-only road repaint admitted")
 var painted=core.capture_storage_snapshot();var painted_ref:PackedByteArray=store.publish_capture(painted,road_ref)
 check(painted.stats().dirty_pages>0 and store.expand_snapshot(painted_ref)==raw(core) and core.commit_storage_snapshot(painted,painted_ref),"material-only changes are captured exactly")
 check(Codec.reply_ok(core.execute(Codec.command(3,[1110,130,1110,2]))),"legacy exact block placed")
 var block_capture=core.capture_storage_snapshot();var block_ref:PackedByteArray=store.publish_capture(block_capture,painted_ref)
 check(block_capture.stats().sample_bytes==0 and block_capture.stats().legacy_block_bytes==8 and store.expand_snapshot(block_ref)==raw(core),"block-only change preserves unchanged terrain samples and exact block state")
 check(core.commit_storage_snapshot(block_capture,block_ref),"block-only checkpoint acknowledged")
 latest=block_ref
 var stale=core.capture_storage_snapshot()
 core.execute(Codec.command(6,[1703,19]))
 check(not core.commit_storage_snapshot(stale,latest),"same revision reset invalidates old captures")
 var empty=core.capture_storage_snapshot();var empty_ref:PackedByteArray=store.publish_capture(empty,latest)
 check(store.expand_snapshot(empty_ref)==raw(core),"explicit reset replaces previous page membership")
 var unsealed:RefCounted=ClassDB.instantiate("NativeTerrainCapture")
 check(store.publish_capture(unsealed).is_empty(),"script-created unsealed capture rejected")
 var report:={"checks":checks,"failures":failures,"initial":initial_stats,"local":small,"scope":"Exact native dirty-page capture, immutable checkpoint merge, stale acknowledgement and failure recovery; runtime paging and total history verification cost remain open."}
 FileAccess.open("res://reports/terrain_dirty_capture.json",FileAccess.WRITE).store_string(JSON.stringify(report,"  "))
 store.close()
 for file:String in DirAccess.get_files_at(path):DirAccess.remove_absolute(path.path_join(file))
 DirAccess.remove_absolute(path)
 print("TERRAIN_DIRTY_CAPTURE failures=",failures);quit(1 if failures else 0)
