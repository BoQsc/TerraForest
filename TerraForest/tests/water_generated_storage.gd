extends "res://tests/water_region_store.gd"
func capture(water:RefCounted,catalog:PackedByteArray)->PackedByteArray:
 var value:Variant=water.capture_storage_snapshot(catalog)
 return value.serialize_snapshot() if value is RefCounted else value
func _initialize()->void:
 var catalog:PackedByteArray=ClassDB.instantiate("NativeLakeCatalog").encode([])
 var source:=packet(125000)
 var offset:int=32+source.decode_u32(8)
 source.encode_u32(offset+12,5)
 var water=ClassDB.instantiate("NativeRegionalWater")
 check(water.restore_snapshot(source),"pristine ocean fixture loads")
 check(water.capture_snapshot(catalog)==source,"ordinary capture still retains complete visible ocean")
 var saved:=capture(water,catalog)
 check(water.validate_snapshot(saved) and saved.decode_u32(12)==0 and saved.decode_u64(16)==0,"storage excludes only regenerable ocean cache")
 check(water.statistics().water_ml==125000 and water.capture_snapshot(catalog)==source,"storage capture leaves live quantities and rendering ownership unchanged")
 source=packet(125000)
 check(water.restore_snapshot(source),"edited ocean fixture loads")
 check(capture(water,catalog)==source,"edited ocean quantities and contacts persist exactly")
 source=packet(0)
 check(water.restore_snapshot(source) and capture(water,catalog)==source,"empty edited ocean override survives to suppress regeneration")
 source=packet(125000);source.encode_u32(offset+12,1)
 check(water.restore_snapshot(source),"ordinary inland fixture loads")
 var ordinary:PackedByteArray=water.capture_snapshot(catalog)
 check(capture(water,catalog)==ordinary and ordinary.decode_u64(16)==125000,"ordinary inland lake persists exactly in canonical encoding")
 var mixed:=source.slice(0,offset);mixed.encode_u32(12,3);mixed.encode_u64(16,250000);mixed.encode_u64(24,36)
 for index in 3:
  var record:=source.slice(offset,offset+9076);record.encode_u64(0,((index+1)<<24)|(9<<12)|250);record.encode_u32(12,[1,5,9][index])
  if index==2:record.encode_u64(20,0)
  mixed.append_array(record)
 var contacts:=PackedByteArray();contacts.resize(36);contacts.fill(0);mixed.append_array(contacts)
 check(water.restore_snapshot(mixed),"mixed lake and ocean fixture loads")
 saved=capture(water,catalog)
 check(water.validate_snapshot(saved) and saved.decode_u32(12)==2 and saved.decode_u64(16)==125000,"mixed storage keeps lake plus empty edited override, omits pristine sea")
 var restored=ClassDB.instantiate("NativeRegionalWater")
 check(restored.restore_snapshot(saved) and restored.statistics().ocean_edited_regions==1 and restored.statistics().ocean_clean_regions==0,"restored ownership is exact")
 print("WATER_GENERATED_STORAGE failures=",failures)
 quit(1 if failures else 0)
