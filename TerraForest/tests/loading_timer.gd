# SPDX-License-Identifier: 0BSD
extends SceneTree
const Timing=preload("res://addons/world_runtime/loading_timer.gd")
var failures:=0
func check(ok:bool,message:String)->void:
 if not ok:failures+=1;push_error(message)
func _initialize()->void:run.call_deferred()
func run()->void:
 var timer=Timing.new();timer.reset(0)
 check(timer.snapshot(0).remaining_us==null,"startup has no invented ETA")
 timer.observe(20,2000000);timer.observe(40,4000000)
 var steady:Dictionary=timer.snapshot(4000000)
 check(steady.elapsed_us==4000000 and steady.remaining_us==6000000,"steady measured work predicts remaining duration")
 check(timer.snapshot(6000000).remaining_us==9000000,"a work pause revises the estimate instead of blindly counting down")
 check(timer.snapshot(14000000).estimate_state=="recalculating" and timer.snapshot(14000000).remaining_us==null,"stalled work withdraws stale estimate")
 timer.observe(60,16000000)
 check(timer.snapshot(16000000).estimate_state=="approximate","progress resumes estimation")
 timer.observe(10,17000000)
 check(timer.progress==60,"late observations cannot rewind measured work")
 timer.observe(100,20000000)
 check(timer.snapshot(30000000).elapsed_us==20000000 and timer.snapshot(30000000).remaining_us==0,"completion freezes total and zero remaining")
 timer.reset(0,94,40000000)
 check(timer.snapshot(0).elapsed_us==40000000 and timer.snapshot(0).remaining_us==null,"process handoff carries elapsed but does not treat 94 percent as new local work")
 timer.observe(95,2000000);timer.observe(96,4000000)
 check(timer.snapshot(4000000).elapsed_us==44000000 and timer.snapshot(4000000).remaining_us==8000000,"handoff estimates only newly measured remaining work")
 timer.stop("cancelling",5000000)
 check(timer.snapshot(8000000).elapsed_us==48000000 and timer.snapshot(8000000).remaining_us==null,"cancellation wait keeps elapsed running without ETA")
 timer.stop("cancelled",9000000)
 check(timer.snapshot(12000000).elapsed_us==49000000,"cancelled operation freezes elapsed")
 timer.reset(0);timer.stop("failed",3000000)
 check(timer.snapshot(9000000).remaining_us==null and timer.snapshot(9000000).elapsed_us==3000000,"failure freezes elapsed without claiming completion")
 timer.reset(0)
 for i in 91:timer.observe(i,1000000*i)
 check(timer.samples.size()<=32 and timer.snapshot(90000000).remaining_us==10000000,"rolling sample window stays bounded on a long operation")
 check(Timing.duration(65000000)=="01:05" and Timing.duration(3661000000)=="1:01:01" and Timing.duration(1,true)=="00:01","timer formatting preserves hours and avoids zero remaining before completion")
 check(Timing.carried_elapsed(Timing.unix_milliseconds()+1000)==0,"future handoff timestamp cannot create negative elapsed")
 FileAccess.open("res://reports/loading_timer.json",FileAccess.WRITE).store_string(JSON.stringify({"failures":failures,"steady":steady,"scope":"Deterministic injected monotonic times: changing throughput, stalls, handoff, completion, failure/cancellation and bounded window. Rendered actual-world UI checked separately."},"  "))
 print("LOADING_TIMER failures=",failures);quit(1 if failures else 0)
