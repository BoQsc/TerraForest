extends "res://tests/water_region_store.gd"
func _initialize()->void:
 var folder:=ProjectSettings.globalize_path("user://water_deferred_save_"+str(Time.get_ticks_usec()))
 var store=ClassDB.instantiate("NativeWaterRegionStore");check(store.open_store(folder),"isolated store opens")
 var original:PackedByteArray=packet(125000);var first:PackedByteArray=store.publish_water_snapshot(original)
 var metadata:Dictionary=store.describe_water_snapshot(first)
 var local:PackedByteArray=packet(64000);local.encode_u64(32+local.decode_u32(8),(100<<24)|(9<<12)|250)
 var merged:PackedByteArray=store.merge_water_snapshot(local,metadata.checkpoint)
 var index:Dictionary=store.describe_water_snapshot(merged)
 check(index.ok and index.archived_regions==2,"resident edit merges with deferred distant reference")
 check(store.read_region(index.checkpoint,Vector3i(1,9,250)).get("packet",PackedByteArray())==original,"unloaded edit preserved byte exactly")
 check(store.read_region(index.checkpoint,Vector3i(100,9,250)).get("packet",PackedByteArray())==local,"new local edit included")
 var dry:PackedByteArray=packet(0);var replaced:PackedByteArray=store.merge_water_snapshot(dry,index.checkpoint)
 var replaced_meta:Dictionary=store.describe_water_snapshot(replaced)
 check(replaced_meta.ok and replaced_meta.archived_regions==2,"replacement does not duplicate or remove membership")
 check(store.read_region(replaced_meta.checkpoint,Vector3i(1,9,250)).get("packet",PackedByteArray())==dry,"empty override replaces only its inherited region")
 check(store.read_region(replaced_meta.checkpoint,Vector3i(100,9,250)).get("packet",PackedByteArray())==local,"unloaded second edit survives local empty replacement")
 check(store.read_region(metadata.checkpoint,Vector3i(1,9,250)).get("packet",PackedByteArray())==original,"prior checkpoint still restores original water")
 var unchanged:PackedByteArray=store.merge_water_snapshot(replaced_meta.base,replaced_meta.checkpoint)
 check(unchanged==replaced,"save with no resident edits preserves all deferred references")
 var bad:PackedByteArray=original.duplicate();bad.encode_u32(32+bad.decode_u32(8)+12,5)
 check(store.merge_water_snapshot(bad,metadata.checkpoint).is_empty(),"pristine resident overlap cannot hide deferred edit")
 var missing:PackedByteArray=metadata.checkpoint.duplicate();missing[0]^=1
 check(store.merge_water_snapshot(local,missing).is_empty(),"missing inherited checkpoint aborts save")
 var restored=ClassDB.instantiate("NativeRegionalWater")
 check(restored.restore_snapshot(store.expand_water_snapshot(replaced)) and restored.statistics().water_ml==64000 and restored.statistics().ocean_edited_regions==2,"combined eager compatibility restore retains exact total and empty ownership")
 store.close();check(store.open_store(folder),"store reopens")
 check(store.expand_water_snapshot(replaced)==restored.capture_snapshot(ClassDB.instantiate("NativeLakeCatalog").encode([])),"merged checkpoint survives reopen exactly")
 store.close();print("WATER_DEFERRED_SAVE failures=",failures);quit(1 if failures else 0)
