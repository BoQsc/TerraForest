extends SceneTree
const Codec=preload("res://addons/volumetric_terrain/mesh_codec.gd")
var failures:=0
func check(ok:bool,label:String)->void:
 print("PASS " if ok else "FAIL ",label)
 if not ok:failures+=1
func _initialize()->void:
 var water=ClassDB.instantiate("NativeRegionalWater")
 var catalog:PackedByteArray=ClassDB.instantiate("NativeLakeCatalog").encode([])
 check(not water.update_ocean_residency(Vector3(NAN,0,0),8).ok,"invalid position rejected")
 check(not water.update_ocean_residency(Vector3.ZERO,33).ok,"admission budget capped")
 var first:Dictionary=water.update_ocean_residency(Vector3(4,40,1000),1)
 check(first.admitted==1 and water.statistics().regions==1,"one-call admission obeys budget")
 var request:Dictionary=water.next_request()
 var patch=ClassDB.instantiate("NativeWaterTerrainPatch")
 check(patch.configure(request.coordinate),"ocean uses existing terrain occupancy patch")
 var core=ClassDB.instantiate("TerrainCore");core.execute(Codec.command(6,[42,19]))
 # Batch and serial preparation must produce byte-identical authoritative data.
 var serial=ClassDB.instantiate("NativeRegionalWater")
 var batched=ClassDB.instantiate("NativeRegionalWater")
 serial.update_ocean_residency(Vector3(4,40,1000),8)
 batched.update_ocean_residency(Vector3(4,40,1000),8)
 check(batched.next_requests(9).is_empty(),"batch request cap enforced")
 var patches:Array=[]
 for coordinate:Vector3i in batched.next_requests(8):
  var single=ClassDB.instantiate("NativeWaterTerrainPatch");single.configure(coordinate)
  for step in 200:
   if single.sample_terrain(core,256,0,0)!=0:break
  check(serial.accept_patch(single),"serial reference occupancy accepted")
  var pending=ClassDB.instantiate("NativeWaterTerrainPatch");pending.configure(coordinate);patches.append(pending)
 var terrain_batch=ClassDB.instantiate("NativeWaterTerrainBatch")
 check(terrain_batch.configure(patches) and not terrain_batch.configure(patches),"batch configured once")
 check(terrain_batch.sample_terrain(core,256,0,0)==0,"batch yields bounded slices")
 check(terrain_batch.sample_terrain(core,256,1,0)==-4 and terrain_batch.sample_terrain(core,256,0,1)==-4,"batch rejects changed revision and cancellation epoch")
 var batch_status:=0
 for step in 2000:
  batch_status=terrain_batch.sample_terrain(core,256,0,0)
  if batch_status!=0:break
 check(batch_status==1,"bounded batch completes")
 for pending:RefCounted in patches:check(batched.accept_patch(pending),"batch occupancy accepted")
 check(serial.capture_snapshot(catalog)==batched.capture_snapshot(catalog),"batch and serial occupancy produce identical saved water")
 var status:=0
 for attempt in 200:
  status=patch.sample_terrain(core,256,0,0)
  if status!=0:break
 check(status==1 and water.accept_patch(patch),"ocean occupancy sampled and accepted")
 var before:Dictionary=water.statistics()
 check(before.water_ml>0 and before.ocean_clean_regions==1 and before.ocean_edited_regions==0,"initial sea-level fill is regenerable native water")
 var snapshot:PackedByteArray=water.capture_snapshot(catalog)
 var changed=ClassDB.instantiate("NativeRegionalWater");changed.restore_snapshot(snapshot)
 var removed:int=changed.brush(Vector3(6,31.8,1002),1.5,-1000000)
 check(removed>0 and changed.statistics().ocean_edited_regions==1,"material removal pins generated ocean region")
 var frozen:Variant=changed.capture_storage_snapshot(catalog)
 var serialized:PackedByteArray=frozen.serialize_snapshot() if frozen is RefCounted else frozen
 var changed_copy=ClassDB.instantiate("NativeRegionalWater")
 check(changed_copy.restore_snapshot(serialized) and changed_copy.statistics().water_ml==before.water_ml-removed and changed_copy.statistics().ocean_edited_regions==1,"worker snapshot retains edit amount and ownership")
 changed_copy.update_ocean_residency(Vector3(1000,40,1000),32)
 check(changed_copy.statistics().water_ml==before.water_ml-removed,"removed material is not regenerated by retirement")

 check(snapshot.decode_u32(4)==10 and water.validate_snapshot(snapshot),"ownership persisted in validated version 10 snapshot")
 var copy=ClassDB.instantiate("NativeRegionalWater")
 check(copy.restore_snapshot(snapshot) and copy.statistics().water_ml==before.water_ml and copy.statistics().ocean_clean_regions==1,"restore retains quantities and regenerable ownership")
 # A terrain edit must pin the region even if it removes no water. Otherwise a
 # later excavation could refill itself when that generated region reappears.
 var origin:Vector3=Vector3(request.coordinate)*4.0
 water.invalidate(AABB(origin,Vector3(4,4,4)),true)
 check(water.statistics().ocean_edited_regions==1,"terrain invalidation makes water durable before asynchronous sampling")
 var saved:PackedByteArray=water.capture_snapshot(catalog)
 var restored=ClassDB.instantiate("NativeRegionalWater")
 check(restored.restore_snapshot(saved),"edited ocean ownership restores")
 for attempt in 12:
  copy.update_ocean_residency(Vector3(1000,40,1000),32)
  restored.update_ocean_residency(Vector3(1000,40,1000),32)
 check(copy.statistics().regions==0 and copy.statistics().water_ml==0,"unmodified distant detail retires")
 check(copy.statistics().ocean_cache_regions==1,"pristine occupancy retained in bounded cache")
 var old_sampled:int=copy.statistics().sampled_nodes
 copy.update_ocean_residency(Vector3(4,40,1000),1)
 check(copy.statistics().ocean_cache_hits==1 and copy.statistics().water_ml==before.water_ml and copy.statistics().sampled_nodes==old_sampled,"return reuses exact water and occupancy without resampling")
 copy.update_ocean_residency(Vector3(1000,40,1000),32)
 copy.invalidate(AABB(origin,Vector3(4,4,4)),true)
 check(copy.statistics().ocean_cache_regions==0 and copy.statistics().ocean_edited_regions==1 and copy.statistics().water_ml==before.water_ml,"distant terrain edit restores cached water before durable invalidation")

 check(restored.statistics().regions==1 and restored.statistics().water_ml==before.water_ml and restored.statistics().ocean_edited_regions==1,"edited distant region and water survive retirement after restore")
 var travel=ClassDB.instantiate("NativeRegionalWater");var maximum:=0
 for stop in 80:
  var position:=Vector3(4,40,20+stop*24)
  for batch in 24:
   var result:Dictionary=travel.update_ocean_residency(position,32)
   if result.admitted>32 or result.retired>32:check(false,"bounded travel admission")
  maximum=maxi(maximum,travel.statistics().regions)
 check(maximum<=1156 and not travel.statistics().capacity_reached,"long shoreline traversal does not accumulate pristine regions")
 check(travel.statistics().cell_steps==0,"no water simulation introduced")
 # Stress eviction with valid flat, pristine cached-region records. This
 # exercises storage limits, not terrain/visual correctness of the fixture.
 var count:=1200;var payload:=PackedByteArray()
 payload.resize(32+catalog.size()+count*(9076+12));payload.fill(0)
 payload.encode_u32(0,0x31575256);payload.encode_u32(4,10)
 payload.encode_u32(8,catalog.size());payload.encode_u32(12,count)
 payload.encode_u64(16,count*125000);payload.encode_u64(24,count*12)
 for i in catalog.size():payload[32+i]=catalog[i]
 for n in count:
  var at:=32+catalog.size()+n*9076
  payload.encode_u64(at,(1<<24)|((7+n/400)<<12)|(n%400))
  payload.encode_u32(at+8,1);payload.encode_u32(at+12,5)
  for i in 512:payload.encode_u16(at+16+i*12+2,500)
  payload.encode_u64(at+20,125000)
  for i in 729:payload.encode_float(at+6160+i*4,1.0)
 var pressure=ClassDB.instantiate("NativeRegionalWater")
 check(pressure.restore_snapshot(payload),"cache pressure fixture valid")
 for step in 40:pressure.update_ocean_residency(Vector3(1000,40,1000),32)
 check(pressure.statistics().regions==0 and pressure.statistics().ocean_cache_regions<=1024 and pressure.statistics().ocean_cache_regions>0 and pressure.statistics().ocean_cache_bytes<=32*1024*1024,"valid pristine cache eviction respects entry and byte limits")
 print("OCEAN_RESIDENCY failures=",failures," max_regions=",maximum)
 quit(1 if failures else 0)
