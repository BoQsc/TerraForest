extends "res://tests/water_storage_failure.gd"
func _initialize()->void:
 var folder:=ProjectSettings.globalize_path("user://water_streaming_save_"+str(Time.get_ticks_usec()))
 DirAccess.make_dir_recursive_absolute(folder)
 var path:=folder.path_join("world.trw");var archive=ClassDB.instantiate("NativeWorldArchive");check(archive.acquire(path),"archive acquired")
 var store=ClassDB.instantiate("NativeWaterRegionStore");check(store.open_store(path+".water"),"store opens")
 var water=ClassDB.instantiate("NativeRegionalWater");var data:PackedByteArray=packet(125000);var p:=Vector3i(1,9,250)
 water.restore_region_snapshot(p,data,0,true)
 var written:Dictionary=store.publish_region(p,data)
 check(water.retire_region(written.receipt,water.survey_revision_id()),"distant region retired")
 var local:PackedByteArray=packet(64000);local.encode_u64(32+local.decode_u32(8),(100<<24)|(9<<12)|250)
 check(water.restore_region_snapshot(Vector3i(100,9,250),local,water.survey_revision_id(),true),"resident local region")
 var catalog:PackedByteArray=ClassDB.instantiate("NativeLakeCatalog").encode([])
 var frozen:Variant=water.capture_storage_snapshot(catalog)
 water.brush(Vector3(400.25,36.25,1000.25),0.1,-1000)
 var backend=Backend.new();backend.save_path=path;backend.snapshot_codec=archive;backend.native=ClassDB.instantiate("TerrainCore")
 backend.native.execute(Codec.command(6,[42,19]))
 var terrain:PackedByteArray=backend.native.execute(Codec.command(4)).slice(12)
 backend.snapshot_validators={"volumetric_water":water}
 backend._apply_components({"epoch":backend.component_epoch,"generation":backend.component_generation+1,"sections":{"volumetric_water":frozen}})
 check(backend._component_capture_valid,"production worker validates frozen mixed-ownership handoff")
 var handoff:PackedByteArray=backend.components.volumetric_water
 var parsed:Dictionary=water.inspect_streaming_snapshot(handoff)
 check(parsed.ok and parsed.coordinates==PackedInt32Array([1,9,250]),"handoff contains unloaded ownership")
 check(not water.restore_snapshot(handoff) and store.expand_water_snapshot(handoff).is_empty(),"transient handoff cannot masquerade as canonical load")
 var bad:PackedByteArray=handoff.duplicate();bad.encode_u32(20,1)
 check(not water.validate_snapshot(bad),"reserved header corruption rejected")
 bad=handoff.duplicate();bad.encode_u64(24+bad.decode_u64(8),(100<<24)|(9<<12)|250)
 check(not water.validate_snapshot(bad),"resident and deferred ownership overlap rejected")
 store.close()
 var sections:Dictionary={"terrain":terrain,"volumetric_water":handoff}
 var result:Dictionary=backend._publish_frozen(sections,terrain,path,archive)
 check(result.success,"production frozen publication retains resident and deferred water")
 var canonical:PackedByteArray=archive.read(path)
 check(backend._load()=="World loaded","production reopen expands checkpoint")
 var restored=ClassDB.instantiate("NativeRegionalWater")
 check(restored.restore_snapshot(backend.components.volumetric_water) and restored.statistics().water_ml==189000,"frozen capture preserves earlier quantity across later edit")
 check(restored.capture_region_snapshot(p)==data and restored.capture_region_snapshot(Vector3i(100,9,250))==local,"both original region packets survive production save/load")
 var blob_path:=path+".water/"+String(written.digest.hex_encode())+".water"
 write_bytes(blob_path,PackedByteArray([1,2,3]))
 result=backend._publish_frozen(sections,terrain,path,archive)
 check(not result.success and archive.read(path)==canonical,"corrupt unloaded dependency aborts publication without replacing canonical")
 archive.release();print("WATER_STREAMING_SAVE failures=",failures);quit(1 if failures else 0)
