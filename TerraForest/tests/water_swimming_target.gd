extends "res://tests/water_return_nearby.gd"
func _initialize():
 GDExtensionManager.load_extension("res://addons/volumetric_water/volumetric_water.gdextension")
 GDExtensionManager.load_extension("res://addons/player_runtime/player_runtime.gdextension")
 var catalog:PackedByteArray=ClassDB.instantiate("NativeLakeCatalog").encode([])
 var water=ClassDB.instantiate("NativeRegionalWater")
 var inventory=ClassDB.instantiate("NativePlayerInventory")
 for id in range(401,412):inventory.register_item(id,1)
 inventory.grant(401,1,0)
 var center:=Vector3(42,42,42)
 var original:=fixture(catalog,center)
 check(water.restore_snapshot(original),"Prepared swimming lake restores")
 var scoop:Dictionary=water.transfer_bucket(center+Vector3.UP*1.5,center-Vector3.UP*.75,false,inventory,0,inventory.snapshot().revision)
 check(scoop.ok,"Create a full-unit cavity")
 var outside:Dictionary=water.raycast_vacancy(center+Vector3.UP,center-Vector3.UP*.75)
 check(outside.hit,"Looking into the cavity from outside still targets its entrance")
 var origin:=center+Vector3(.1,-.25,.1)
 var destination:=origin+Vector3(1.3,0,0)
 var inside:Dictionary=water.raycast_vacancy(origin,destination)
 print("SWIMMING origin=",origin," vacancy=",inside," visible_surface=",water.raycast_surface(origin,destination))
 check(not inside.hit,"A cavity surrounding the swimming camera cannot intercept the aim")
 var across_cells:Dictionary=water.raycast_vacancy(center+Vector3(-.4,-.25,.1),destination)
 check(not across_cells.hit,"Adjacent vacant cells do not create invisible internal targets")
 var returned:Dictionary=water.transfer_bucket(origin,destination,true,inventory,0,inventory.snapshot().revision)
 check(returned.ok and amounts(original)==amounts(water.capture_snapshot(catalog)),"Pouring at the visible cavity wall restores the original water exactly")
 print("WATER_SWIMMING_TARGET failures=",failures);quit(failures)
